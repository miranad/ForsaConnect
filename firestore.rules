rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.token.get('email_verified', false) == true
        && (request.auth.token.get('admin', false) == true
          || (exists(/databases/$(database)/documents/administrators/$(request.auth.uid))
            && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.get('active', false) == true));
    }
    match /administrators/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid && request.auth.token.get('email_verified', false) == true;
      allow list, create, update, delete: if false;
    }
    function text(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function validDraft(d) {
      return text(d.title,6,200) && text(d.organizer,3,200) && text(d.description,15,5000)
        && text(d.category,1,80) && text(d.location,1,200) && text(d.deadline,1,200)
        && text(d.eligibility,1,2000) && text(d.cost,1,500) && text(d.url,1,2000)
        && d.url.matches('https://[A-Za-z0-9.-]+(:[0-9]{1,5})?([/?#].*)?')
        && d.scope in ['داخل المغرب','خارج المغرب','عن بعد'];
    }
    match /submissions/{id} {
      allow create: if request.auth != null
        && id.matches('FC-PROP-[a-f0-9]{64}') && request.resource.data.id == id
        && request.resource.data.keys().hasOnly(['id','title','organizer','description','category','scope','location','deadline','eligibility','cost','url','status','submittedBy','createdAt'])
        && validDraft(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow read: if admin();
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminNotes','reviewedBy','reviewedAt'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && text(request.resource.data.adminNotes,1,2000)
        && ((resource.data.status == 'pending' && request.resource.data.status in ['approved','rejected'])
          || (resource.data.status == 'approved' && request.resource.data.status == 'rejected')
          || (resource.data.status == 'approved' && request.resource.data.status == 'published'
            && getAfter(/databases/$(database)/documents/publishedOpportunities/$(id)).data.submissionId == id));
      allow delete: if false;
    }
    match /publishedOpportunities/{id} {
      allow read: if true;
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['submissionId','opportunity','publishedAt','publishedBy'])
        && request.resource.data.submissionId == id
        && request.resource.data.publishedBy == request.auth.uid
        && request.resource.data.publishedAt == request.time
        && get(/databases/$(database)/documents/submissions/$(id)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/submissions/$(id)).data.status == 'published'
        && matchingOpportunity(request.resource.data.opportunity, getAfter(/databases/$(database)/documents/submissions/$(id)).data);
      allow update, delete: if false;
    }
    function matchingOpportunity(o, d) {
      return o.keys().hasOnly(['id','title_ar','category','scope','location','organization','description_ar','eligibility_ar','event_date','application_deadline','cost_ar','application_method_ar','verification_status','source_url','notes_ar','verified_on','isCustom','adminStatus'])
        && o.id == d.id && o.title_ar == d.title && o.category == d.category && o.scope == d.scope
        && o.location == d.location && o.organization == d.organizer && o.description_ar == d.description
        && o.eligibility_ar == d.eligibility && o.application_deadline == d.deadline && o.cost_ar == d.cost
        && o.source_url == d.url && o.isCustom == true && o.adminStatus == 'approved'
        && o.verification_status == 'بحاجة إلى تحقق'
        && text(o.event_date,1,200) && text(o.application_method_ar,1,200)
        && text(o.notes_ar,1,1000) && o.verified_on.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    match /catalogEdits/{id} {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['opportunity','visible','updatedAt','updatedBy'])
        && request.resource.data.visible is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && validCatalogOpportunity(request.resource.data.opportunity, id);
      allow delete: if false;
    }
    function validCatalogOpportunity(o, id) {
      return id.matches('FC-([0-9]{3}|PROP-[a-f0-9]{64})') && o.id == id
        && o.keys().hasOnly(['id','title_ar','organization','category','scope','location','description_ar','eligibility_ar','event_date','application_deadline','cost_ar','application_method_ar','verification_status','source_url','verified_on','notes_ar','isCustom','adminStatus'])
        && text(o.title_ar,6,200) && text(o.organization,3,200) && text(o.category,1,80)
        && o.scope in ['داخل المغرب','خارج المغرب','عن بعد'] && text(o.location,1,200)
        && text(o.description_ar,15,5000) && text(o.eligibility_ar,1,2000)
        && text(o.event_date,1,200) && text(o.application_deadline,1,200)
        && text(o.cost_ar,1,500) && text(o.application_method_ar,1,500)
        && text(o.verification_status,1,200) && text(o.source_url,1,2000)
        && o.source_url.matches('https://[A-Za-z0-9.-]+(:[0-9]{1,5})?([/?#].*)?')
        && o.verified_on.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && text(o.get('notes_ar',''),0,2000)
        && o.get('isCustom',false) is bool
        && o.get('adminStatus','approved') in ['approved','pending','rejected','needs_review'];
    }
    match /{document=**} { allow read, write: if false; }
  }
}
